# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting_exchange
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# NATS
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=betting-cluster

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# API Gateway
API_GATEWAY_PORT=3000
WS_PORT=3001

# Matching Engine
MATCHING_ENGINE_PORT=3100

# Wallet Service
WALLET_SERVICE_PORT=3200

# Market Data Service
MARKET_DATA_PORT=3300

# Settlement Service
SETTLEMENT_SERVICE_PORT=3400

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug
# Set DISABLE_LOGS=true to disable all logging across services (useful for performance testing)
# DISABLE_LOGS=false
