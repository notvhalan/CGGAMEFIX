# ── E2E test environment ──────────────────────────────────
# By default, these point to the *dev* stack (docker-compose.yml).
# To run against the isolated test stack (docker-compose.test.yml),
# change the ports below to 5433 / 6380 / 4223 respectively.

# API Gateway (must be running)
API_URL=http://localhost:3000

# Rust Exchange (must be running)
RUST_EXCHANGE_URL=http://localhost:3001
RUST_WS_URL=ws://localhost:3001/ws

# PostgreSQL — direct connection for assertions
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting_exchange

# Timeout for async polling (ms)
POLL_TIMEOUT_MS=10000
POLL_INTERVAL_MS=100
