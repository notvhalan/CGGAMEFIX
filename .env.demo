# Demo/Mock Mode Environment
# Runs with in-memory storage - no external databases required

NODE_ENV=demo

# Mock Data Mode
MOCK_MODE=true
USE_MEMORY_DB=true
USE_MEMORY_CACHE=true
USE_MEMORY_QUEUE=true
SEED_DEMO_DATA=true

# Services (all running in single container for cost savings)
API_GATEWAY_PORT=3000
WEBSOCKET_PORT=3001

# In-Memory Storage (no external services needed)
DATABASE_URL=memory://
REDIS_URL=memory://
NATS_URL=memory://

# Frontend
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3001

# Security (still use secure JWT for demo)
JWT_SECRET=demo-jwt-secret-change-for-production
JWT_EXPIRES_IN=7d

# Demo Data Configuration
DEMO_USER_COUNT=50
DEMO_MARKET_COUNT=10
DEMO_ORDER_COUNT=100
RESET_DATA_DAILY=true

# Google OAuth (optional for demo)
GOOGLE_CLIENT_ID=demo-client-id
GOOGLE_CLIENT_SECRET=demo-client-secret

# Logging
LOG_LEVEL=info

# AWS (only for deployment, not for data storage)
AWS_REGION=us-east-1
