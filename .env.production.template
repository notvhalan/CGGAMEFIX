# AWS Production Environment Template
# Copy this to .env.production and fill in your AWS values
# DO NOT commit .env.production to git

NODE_ENV=production

# Database (RDS PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@your-rds-instance.region.rds.amazonaws.com:5432/betting_exchange
POSTGRES_HOST=your-rds-instance.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=betting_exchange
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password

# Redis (ElastiCache)
REDIS_URL=redis://your-elasticache-cluster.cache.amazonaws.com:6379
REDIS_HOST=your-elasticache-cluster.cache.amazonaws.com
REDIS_PORT=6379

# NATS (ECS Service)
NATS_URL=nats://nats-service.betting-exchange.local:4222
NATS_HOST=nats-service.betting-exchange.local
NATS_PORT=4222

# Services (Internal ECS Service Discovery)
API_GATEWAY_URL=https://api.yourdomain.com
API_GATEWAY_PORT=3000
WEBSOCKET_PORT=3001

MATCHING_ENGINE_HOST=matching-engine.betting-exchange.local
MATCHING_ENGINE_PORT=3100

WALLET_SERVICE_HOST=wallet-service.betting-exchange.local
WALLET_SERVICE_PORT=3200

MARKET_DATA_HOST=market-data.betting-exchange.local
MARKET_DATA_PORT=3300

SETTLEMENT_SERVICE_HOST=settlement-service.betting-exchange.local
SETTLEMENT_SERVICE_PORT=3400

# Frontend
WEB_URL=https://yourdomain.com
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com

# Security (GENERATE STRONG SECRETS!)
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# AWS Specific
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Logging
LOG_LEVEL=info

# CloudWatch (optional)
CLOUDWATCH_LOG_GROUP=/ecs/betting-exchange
