# Hybrid Deployment Configuration
# Frontend on AWS S3/CloudFront, Backend running locally

# Local Backend Services
NODE_ENV=production

# Local infrastructure (Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/betting_exchange
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=betting_exchange
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

NATS_URL=nats://localhost:4222
NATS_HOST=localhost
NATS_PORT=4222

# API Gateway (exposed via Cloudflare Tunnel or ngrok)
API_GATEWAY_PORT=3000
WEBSOCKET_PORT=3001

# Public URLs (after tunnel setup)
API_PUBLIC_URL=https://api.yourdomain.com
WS_PUBLIC_URL=wss://api.yourdomain.com

# Frontend (hosted on AWS)
FRONTEND_URL=https://yourdomain.com

# CORS - Allow requests from AWS-hosted frontend
CORS_ORIGINS=https://yourdomain.com,https://your-bucket.s3-website-us-east-1.amazonaws.com

# Security
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# Logging
LOG_LEVEL=info

# AWS (only for S3 deployment)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-betting-exchange-frontend
CLOUDFRONT_DIST_ID=your-distribution-id
