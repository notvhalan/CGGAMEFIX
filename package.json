{
  "name": "betting-exchange-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "P2P Betting Exchange - Orderbook & Matching Engine",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream run dev",
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:engine": "pnpm --filter matching-engine dev",
    "dev:wallet": "pnpm --filter wallet-service dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "setup": "pnpm install && pnpm run docker:up",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "test:e2e:infra": "docker-compose -f docker-compose.test.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "pg": "^8.18.0"
  }
}
