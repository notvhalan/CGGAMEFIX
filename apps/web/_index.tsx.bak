              <span className="hiw-row-badge" style={{ background: 'rgba(63,185,80,0.12)', color: '#3fb950', borderColor: 'rgba(63,185,80,0.25)' }}>MATHEMATICAL FRAMEWORK</span>
              <h3>Hazard-rate pricing</h3>
