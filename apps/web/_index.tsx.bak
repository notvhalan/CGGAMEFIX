              <p>
                <strong>YES</strong> pays £1 if the event has <em>not</em> occurred by time <InlineMath math="T" />.{" "}
                <strong>NO</strong> pays £1 if it <em>has</em>.
                Together: <InlineMath math="Y(T) + N(T) = 1" />.
              </p>
            </div>
            <div className="hiw-visual-media">
              <img src="/media/img/PastedGraphic-2s.png" alt="Contract payoff diagram" />
            </div>
          </div>

          {/* ── What you can trade ────────────────────────── */}
