/* LANDING PAGE STYLES */

/* ---------- Design tokens ---------- */
:root {
  --bg: #0d1117;
  --panel: #0f141b;
  --panel-2: #161b22;
  --text: #c9d1d9;
  --muted: #8b949e;
  --line: rgba(255, 255, 255, 0.08);
  --line-strong: rgba(255, 255, 255, 0.12);

  --brand: #58a6ff;
  --brand-2: #00f2ea;
  --good: #3fb950;

  --radius: 18px;
  --radius-lg: 26px;
  --shadow: 0 18px 60px rgba(0, 0, 0, 0.55);
}

/* ---------- Base ---------- */
.landing-container {
  min-height: 100vh;
  color: var(--text);
  background: radial-gradient(1200px 800px at 70% -10%, rgba(88, 166, 255, 0.16), transparent 60%),
              radial-gradient(900px 700px at 20% 20%, rgba(0, 242, 234, 0.10), transparent 55%),
              var(--bg);
}

/* Optional: subtle grain overlay — reduced opacity to keep foreground dominant */
.landing-container::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 10% 10%, rgba(255,255,255,0.02), transparent 35%),
    radial-gradient(circle at 90% 30%, rgba(255,255,255,0.015), transparent 45%);
  opacity: 0.35;
  mix-blend-mode: overlay;
}

/* Glassmorphism Animation - Cinematic Reveal */
@keyframes cinematicReveal {
  0% {
    opacity: 0;
    /* Start slightly smaller and lower */
    transform: scale(0.94) translateY(40px);
    /* Heavy blur for the 'dreamy' start */
    filter: blur(24px);
  }
  30% {
    opacity: 1; /* Fade in quickly, let the blur/movement finish slowly */
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: blur(0);
  }
}

/* Window Opening Animation - 1.8 seconds, ultra smooth glass UI */
@keyframes windowOpen {
  0% {
    opacity: 0;
    transform: scale(0.3) rotateX(15deg);
    filter: blur(20px) brightness(0.5);
    box-shadow: 
      inset 0 0 0 0 rgba(255, 255, 255, 0),
      0 0 0 0 rgba(0, 0, 0, 0),
      0 0 0 0 rgba(88, 166, 255, 0);
  }
  35% {
    opacity: 0.7;
    transform: scale(0.88) rotateX(3deg);
    filter: blur(8px) brightness(0.85);
  }
  65% {
    opacity: 0.95;
    transform: scale(1.02) rotateX(-1deg);
    filter: blur(2px) brightness(1);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotateX(0deg);
    filter: blur(0) brightness(1);
    box-shadow: 
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1),
      0 8px 32px 0 rgba(0, 0, 0, 0.3),
      0 0 80px 0 rgba(88, 166, 255, 0.05);
  }
}

/* Keep legacy zoomIn for other elements */
@keyframes zoomIn {
  0% {
    opacity: 0;
    transform: scale(0.9) translateY(20px);
    filter: blur(10px);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: blur(0);
  }
}

/* Glass Card Effect - Luxury Edition */
.glass-card {
  background: rgba(22, 27, 34, 0.35);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24px;
  box-shadow: 
    inset 0 1px 0 0 rgba(255, 255, 255, 0.15), /* Top inner highlight */
    0 8px 32px 0 rgba(0, 0, 0, 0.25),
    0 0 80px 0 rgba(88, 166, 255, 0.08); /* Subtle outer glow */
  padding: 1.5rem;
  /* Cinematic reveal: 1.4s with soft landing bezier */
  animation: cinematicReveal 1.4s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  opacity: 0;
  position: relative;
  overflow: hidden;
}

/* Real-time chart gets special window opening animation */
.realtime-chart.glass-card {
  animation: windowOpen 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  transform-style: preserve-3d;
  perspective: 1000px;
}

/* Gradient border effect */
.glass-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 24px;
  padding: 1px;
  background: linear-gradient(145deg, rgba(88, 166, 255, 0.4), rgba(255, 255, 255, 0.05));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.glass-card:nth-child(1) {
  animation-delay: 0.2s;
}

.glass-card:nth-child(2) {
  animation-delay: 0.4s;
}

.glass-card:nth-child(3) {
  animation-delay: 0.6s;
}

.glass-card:nth-child(4) {
  animation-delay: 0.8s;
}

/* Ambient Lighting Effect */
.ambient-glow {
  position: absolute;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
  filter: blur(80px);
  animation: pulseGlow 4s ease-in-out infinite;
}

@keyframes pulseGlow {
  0%, 100% {
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

/* ---------- Navbar (transparent on load, glass on scroll) ---------- */
.landing-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 120;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 1.1rem 3rem;
  background: transparent;
  border-bottom: 1px solid transparent;

  transition: background 250ms ease, border-color 250ms ease, transform 250ms ease;
}

.landing-nav.scrolled {
  background: rgba(13, 17, 23, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}

.landing-logo {
  color: white;
  margin: 0;
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
}

.landing-logo::before {
  content: "";
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: radial-gradient(circle, var(--brand-2), var(--brand));
  box-shadow: 0 0 18px rgba(0, 242, 234, 0.35);
}

.landing-nav-links {
  display: flex;
  gap: 1rem;
  align-items: center;
}

.nav-link {
  color: rgba(201, 209, 217, 0.88);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: -0.01em;
  padding: 0.55rem 0.6rem;
  border-radius: 10px;
  transition: color 0.2s, background 0.2s;
}

.nav-link:hover {
  color: white;
  background: rgba(255, 255, 255, 0.06);
}

.nav-link.active {
  color: white;
  background: rgba(88, 166, 255, 0.1);
  border: 1px solid rgba(88, 166, 255, 0.14);
}

.nav-login-btn {
  color: #0b1020;
  text-decoration: none;
  padding: 0.65rem 1.05rem;
  background: linear-gradient(135deg, var(--brand), rgba(0, 242, 234, 0.8));
  border-radius: 12px;
  font-weight: 800;
  letter-spacing: -0.01em;
  box-shadow: 0 10px 30px rgba(88, 166, 255, 0.18);
  transition: transform 0.2s ease, filter 0.2s ease;
}

.nav-login-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.05);
}

/* ---------- Hero ---------- */
@keyframes heroKenBurns {
  0%   { transform: scale(1.08) translate(-5px, -8px); filter: saturate(0.9) contrast(1.02); }
  100% { transform: scale(1.18) translate(5px, -15px); filter: saturate(1.05) contrast(1.12); }
}

.hero-section {
  min-height: 100vh;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  padding: 0 2rem 4rem 2rem; /* nav is fixed/overlaid — no top padding needed */
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0.35;
  z-index: 0;
  filter: blur(3px) saturate(0.6);
  transition: opacity 0.8s ease;
}
.hero-bg.fading {
  opacity: 0;
}

/* Scroll indicator arrow */
@keyframes scrollBounce {
  0%, 100% { transform: translateY(0); opacity: 0.7; }
  50%       { transform: translateY(8px); opacity: 1; }
}

.hero-scroll-indicator {
  position: absolute;
  bottom: 92px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  color: rgba(230, 237, 243, 0.55);
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: scrollBounce 2s ease-in-out infinite;
  transition: color 0.2s;
}

.hero-scroll-indicator svg {
  width: 48px;
  height: 48px;
  stroke-width: 1.5;
}

.hero-scroll-indicator:hover {
  color: #e6edf3;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(700px 500px at 50% 30%, rgba(88, 166, 255, 0.06), transparent 60%),
    radial-gradient(900px 700px at 50% 110%, rgba(0, 242, 234, 0.04), transparent 60%),
    linear-gradient(135deg, rgba(13, 17, 23, 0.4) 0%, rgba(22, 27, 34, 0.5) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1280px;
  padding: 0 2rem;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 40px;
  align-items: center;
}

.hero-left {
  text-align: left;
}

.hero-right {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

@media (max-width: 860px) {
  .hero-content {
    grid-template-columns: 1fr;
    gap: 36px;
    text-align: center;
  }
  .hero-left {
    text-align: center;
  }
  .hero-right {
    justify-content: center;
  }
  .hero-card-system {
    max-width: 480px;
    margin: 0 auto;
  }
  .hero-steps {
    justify-content: center;
    flex-wrap: wrap;
  }
  .hero-cred {
    justify-content: center;
  }
  .hms-row {
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
  }
}

@media (max-width: 480px) {
  .hero-card-system {
    max-width: 100%;
  }
  .hero-market-card {
    padding: 20px;
  }
  .hero-maturity-strip {
    padding: 12px 20px 10px;
  }
  .hms-row {
    grid-template-columns: repeat(3, 1fr);
  }
  .hero-steps {
    flex-direction: column;
    align-items: center;
  }
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.4rem 0.75rem;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.04);
  color: rgba(201, 209, 217, 0.92);
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: -0.01em;
  margin-bottom: 1.2rem;
  animation: zoomIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  opacity: 0;
}

.hero-kicker b {
  color: white;
}

.hero-title {
  font-size: clamp(2.2rem, 3.6vw, 4rem);
  font-weight: 900;
  margin: 0 0 1.2rem 0;
  color: white;
  letter-spacing: -0.045em;
  line-height: 1.02;
  animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.08s forwards;
  opacity: 0;
}

.hero-title .grad {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-subtitle {
  font-size: clamp(0.95rem, 1.2vw, 1.08rem);
  color: rgba(201, 209, 217, 0.95);
  max-width: 420px;
  margin: 0 0 1.4rem 0;
  line-height: 1.65;
  letter-spacing: -0.01em;
  animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.22s forwards;
  opacity: 0;
}

@media (max-width: 860px) {
  .hero-subtitle {
    margin: 0 auto 1.8rem auto;
    max-width: 560px;
  }
}

.hero-cta {
  display: flex;
  gap: 0.85rem;
  justify-content: flex-start;
  flex-wrap: wrap;
  margin-top: 1.8rem;
  animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
  opacity: 0;
}

@media (max-width: 860px) {
  .hero-cta {
    justify-content: center;
  }
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.9rem 1.15rem;
  border-radius: 14px;
  font-weight: 900;
  letter-spacing: -0.01em;
  text-decoration: none;
  transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, filter 0.2s ease;
  user-select: none;
}

.btn-primary {
  color: #081021;
  background: linear-gradient(135deg, var(--brand), rgba(0, 242, 234, 0.86));
  box-shadow: 0 12px 32px rgba(88, 166, 255, 0.14);
  padding: 0.9rem 1.5rem;
}

.btn-primary:hover {
  transform: translateY(-1px);
  filter: brightness(1.05);
}

.btn-secondary {
  color: rgba(230, 237, 243, 0.7);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  font-weight: 700;
}

.btn-secondary:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--line-strong);
}

/* Hero "showpiece" area (your chart) */
.hero-showcase {
  position: relative;
  margin-top: 0;
  display: grid;
  place-items: center;
  width: 100%;
}

.hero-showcase-inner {
  width: min(980px, 100%);
  border-radius: var(--radius-lg);
  padding: 0.25rem;
  background: linear-gradient(145deg, rgba(88, 166, 255, 0.18), rgba(255, 255, 255, 0.03));
}

/* ---------- Stats ---------- */
.stats-section {
  padding: 4.3rem 3rem 4.8rem 3rem;
  max-width: 1200px;
  margin: 0 auto;
}

.section-eyebrow {
  color: rgba(201, 209, 217, 0.75);
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-size: 0.82rem;
  margin-bottom: 0.8rem;
}

.section-title {
  font-size: clamp(1.8rem, 2.6vw, 2.6rem);
  font-weight: 900;
  margin: 0 0 1.2rem 0;
  color: white;
  letter-spacing: -0.03em;
}

.section-lead {
  color: var(--muted);
  max-width: 820px;
  line-height: 1.7;
  margin: 0 0 2.2rem 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 1.2rem;
}

.stats-grid .glass-card {
  grid-column: span 3;
  text-align: left;
  padding: 1.7rem;
}

.stat-label {
  color: rgba(201, 209, 217, 0.78);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.75rem;
  margin-bottom: 0.8rem;
}

.stat-value {
  font-size: 2.4rem;
  font-weight: 900;
  color: var(--brand);
  margin: 0 0 0.5rem 0;
  letter-spacing: -0.03em;
}

.stat-value.success {
  color: var(--good);
}

.stat-description {
  color: var(--muted);
  font-size: 1rem;
  line-height: 1.55;
  margin: 0;
}

/* ---------- Content band ---------- */
.content-section {
  padding: 5.2rem 3rem;
  background: linear-gradient(180deg, rgba(22, 27, 34, 0.9), rgba(13, 17, 23, 0.9));
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.content-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 2rem;
  align-items: center;
}

.section-text {
  font-size: 1.15rem;
  line-height: 1.8;
  color: var(--text);
  margin: 0;
}

.callout {
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.04);
  border-radius: var(--radius-lg);
  padding: 1.4rem;
}

.callout h4 {
  margin: 0 0 0.6rem 0;
  color: white;
  font-weight: 900;
  letter-spacing: -0.02em;
}

.callout p {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}

/* ---------- Features ---------- */
.features-section {
  padding: 5.2rem 3rem;
  max-width: 1200px;
  margin: 0 auto;
}

.features-grid {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  gap: 3.2rem;
  align-items: start;
}

.feature-content h3 {
  font-size: 2rem;
  font-weight: 900;
  margin-bottom: 1rem;
  color: white;
  letter-spacing: -0.03em;
}

.feature-text {
  font-size: 1.1rem;
  line-height: 1.8;
  color: var(--text);
  margin-bottom: 1.25rem;
}

.feature-link {
  color: var(--brand);
  text-decoration: none;
  font-size: 1.05rem;
  font-weight: 800;
  display: inline-flex;
  gap: 0.45rem;
  align-items: center;
  margin-bottom: 1.4rem;
  transition: transform 0.2s ease, color 0.2s ease;
}

.feature-link:hover {
  transform: translateX(2px);
  color: rgba(0, 242, 234, 0.95);
}

/* video container stays but looks more premium */
.video-container {
  width: 100%;
  aspect-ratio: 16/9;
  background: rgba(255, 255, 255, 0.04);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
  animation: zoomIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  opacity: 0;
}

/* ---------- Footer ---------- */
.landing-footer {
  padding: 3.2rem 3rem;
  border-top: 1px solid var(--line);
  background: rgba(13, 17, 23, 0.75);
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1.4rem;
}

.footer-logo {
  color: white;
  font-size: 1rem;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.footer-links {
  display: flex;
  gap: 1.4rem;
  flex-wrap: wrap;
}

.footer-link {
  color: rgba(201, 209, 217, 0.78);
  text-decoration: none;
  font-weight: 700;
  transition: color 0.2s;
}

.footer-link:hover {
  color: white;
}

.footer-carvum {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: #8b949e;
  font-size: 0.8125rem;
  font-weight: 500;
  text-decoration: none;
  padding: 0.375rem 0.875rem;
  border-radius: 999px;
  border: 1px solid rgba(139, 148, 158, 0.2);
  background: rgba(139, 148, 158, 0.05);
  transition: color 0.2s, border-color 0.2s;
}
.footer-carvum:hover {
  color: #58a6ff;
  border-color: rgba(88, 166, 255, 0.35);
}

/* ---------- Hero Kicker ---------- */
.kicker-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3fb950;
  box-shadow: 0 0 10px rgba(63, 185, 80, 0.5);
  animation: livePulse 2s ease-in-out infinite;
}

/* ---------- Hero 3-step mental model ---------- */
.hero-steps {
  display: flex;
  gap: 0.6rem;
  margin: 1.2rem 0 0;
  animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
  opacity: 0;
}

.hero-step {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.85rem;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.04);
  transition: border-color 0.2s, background 0.2s;
}

.hero-step:hover {
  background: rgba(255, 255, 255, 0.045);
  border-color: rgba(255, 255, 255, 0.08);
}

/* Icon-based step indicators */
.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 7px;
  flex-shrink: 0;
}

.step-icon--buy {
  background: rgba(63, 185, 80, 0.12);
  color: #3fb950;
}

.step-icon--prob {
  background: rgba(88, 166, 255, 0.12);
  color: #58a6ff;
}

.step-icon--settle {
  background: rgba(0, 242, 234, 0.10);
  color: #00f2ea;
}

/* Keep old .step-num for backward compat */
.step-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(88, 166, 255, 0.14);
  color: #58a6ff;
  font-weight: 800;
  font-size: 0.65rem;
  flex-shrink: 0;
}

.step-text {
  font-size: 0.78rem;
  color: rgba(230, 237, 243, 0.72);
  line-height: 1.3;
}

.step-eg {
  color: #8b949e;
  font-size: 0.78rem;
}

/* ═══════════════════════════════════════════════════════════
   HERO MARKET CARD — Premium glass panel system
   ═══════════════════════════════════════════════════════════ */

.hero-card-system {
  --card-radius: 22px;
  --card-bg: rgba(10, 14, 20, 0.88);
  --card-border: rgba(255, 255, 255, 0.06);
  --card-pad-x: 26px;
  --card-pad-y: 24px;
  --accent: #58a6ff;

  width: 100%;
  max-width: 500px;
  position: relative;
  isolation: isolate;
}

/* ── Double-layer ambient glow ── */
.hcs-glow {
  position: absolute;
  inset: -60px -50px;
  z-index: -2;
  border-radius: 50%;
  background: radial-gradient(
    ellipse 420px 340px at 50% 40%,
    rgba(88, 166, 255, 0.07) 0%,
    rgba(0, 242, 234, 0.03) 45%,
    transparent 72%
  );
  filter: blur(50px);
  pointer-events: none;
  animation: glowPulse 6s ease-in-out infinite alternate;
}

.hcs-glow-accent {
  position: absolute;
  bottom: -30px;
  right: -20px;
  width: 200px;
  height: 200px;
  z-index: -1;
  border-radius: 50%;
  background: radial-gradient(
    circle at center,
    rgba(0, 242, 234, 0.05) 0%,
    transparent 65%
  );
  filter: blur(35px);
  pointer-events: none;
}

@keyframes glowPulse {
  0%   { opacity: 0.7; transform: scale(1); }
  100% { opacity: 1;   transform: scale(1.04); }
}

/* ── The card itself ── */
.hero-market-card {
  width: 100%;
  padding: var(--card-pad-y) var(--card-pad-x);
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--card-radius);
  box-shadow:
    0 0 0 0.5px rgba(255, 255, 255, 0.04),
    0 1px 3px rgba(0, 0, 0, 0.4),
    0 12px 40px rgba(0, 0, 0, 0.45),
    0 30px 80px -10px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(40px) saturate(1.3);
  -webkit-backdrop-filter: blur(40px) saturate(1.3);
  position: relative;
  z-index: 2;

  /* Top-edge specular highlight */
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1) 40%,
      rgba(255, 255, 255, 0.14) 50%,
      rgba(255, 255, 255, 0.1) 60%,
      transparent
    );
    z-index: 3;
  }

  /* Subtle noise grain */
  &::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.02;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: 0;
  }
}

/* ── Top bar: badge + live ── */
.hmc-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.hmc-header-left {
  display: flex;
  align-items: center;
  gap: 8px;
}

.hmc-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.64rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  padding: 5px 10px;
  border-radius: 8px;
  background: rgba(88, 166, 255, 0.06);
  color: rgba(143, 174, 213, 0.9);
  border: 1px solid rgba(88, 166, 255, 0.08);
}

.hmc-badge-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--accent);
  opacity: 0.6;
}

.hmc-live {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.6rem;
  font-weight: 700;
  color: rgba(63, 185, 80, 0.85);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #3fb950;
  box-shadow: 0 0 8px rgba(63, 185, 80, 0.5);
  animation: livePulse 2s ease-in-out infinite;
}

/* ── Question ── */
.hmc-question {
  font-size: 1.05rem;
  font-weight: 700;
  color: rgba(230, 237, 243, 0.95);
  line-height: 1.4;
  margin: 0 0 12px;
  letter-spacing: -0.015em;
}

/* ── Resolve row ── */
.hmc-resolve-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.hmc-resolve-tag {
  font-size: 0.6rem;
  font-weight: 600;
  color: rgba(63, 185, 80, 0.7);
  letter-spacing: 0.02em;
}

.hmc-resolve-sep {
  width: 1px;
  height: 10px;
  background: rgba(255, 255, 255, 0.06);
}

.hmc-resolve-date {
  font-size: 0.6rem;
  font-weight: 600;
  color: #6e7681;
  letter-spacing: 0.02em;
}

/* ── YES / NO Buttons ── */
.hmc-prices {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 18px;
}

.hmc-btn {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  padding: 0;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  cursor: pointer;
  font-family: inherit;
  transition:
    transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
    border-color 0.2s,
    box-shadow 0.3s;
}

.hmc-btn-inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 14px 16px;
}

/* Animated fill bar behind text */
.hmc-btn-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  transition: width 1.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.hmc-btn-label {
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.hmc-btn-price {
  font-size: 1.5rem;
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 1;
  display: flex;
  align-items: baseline;
  color: #e6edf3;
}

.hmc-btn-unit {
  font-size: 0.75rem;
  font-weight: 700;
  color: #8b949e;
  margin-left: 1px;
}

/* YES variant */
.hmc-btn--yes {
  background: rgba(63, 185, 80, 0.04);
  border-color: rgba(63, 185, 80, 0.1);
}
.hmc-btn--yes .hmc-btn-fill {
  background: linear-gradient(90deg, rgba(63, 185, 80, 0.1), rgba(63, 185, 80, 0.03));
}
.hmc-btn--yes .hmc-btn-label { color: #3fb950; }
.hmc-btn--yes:hover {
  border-color: rgba(63, 185, 80, 0.3);
  box-shadow: 0 4px 20px rgba(63, 185, 80, 0.08), inset 0 0 24px rgba(63, 185, 80, 0.03);
  transform: translateY(-2px);
}

/* NO variant */
.hmc-btn--no {
  background: rgba(218, 54, 51, 0.04);
  border-color: rgba(218, 54, 51, 0.1);
}
.hmc-btn--no .hmc-btn-fill {
  background: linear-gradient(90deg, rgba(218, 54, 51, 0.1), rgba(218, 54, 51, 0.03));
}
.hmc-btn--no .hmc-btn-label { color: #f0615d; }
.hmc-btn--no:hover {
  border-color: rgba(218, 54, 51, 0.3);
  box-shadow: 0 4px 20px rgba(218, 54, 51, 0.08), inset 0 0 24px rgba(218, 54, 51, 0.03);
  transform: translateY(-2px);
}

/* ── Probability curve section ── */
.hmc-curve-section {
  padding: 14px 0 10px;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.hmc-curve-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 4px;
}

.hmc-curve-title {
  font-size: 0.58rem;
  font-weight: 700;
  color: #484f58;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.hmc-prob-val {
  font-size: 1.15rem;
  font-weight: 800;
  color: #B0D6E2;
  letter-spacing: -0.02em;
  text-shadow: 0 0 18px rgba(176, 214, 226, 0.12);
  font-family: 'SF Mono', 'Fira Code', monospace;
}

.hmc-curve-wrap {
  margin: 0;
}

.prob-curve-svg {
  width: 100%;
  height: auto;
  display: block;
}

/* ── Footer stats ── */
.hmc-footer {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  padding: 12px 0 2px;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.hmc-foot-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
}

.hmc-foot-label {
  font-size: 0.55rem;
  font-weight: 600;
  color: #484f58;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.hmc-foot-value {
  font-size: 0.72rem;
  font-weight: 700;
  color: #8b949e;
  font-family: 'SF Mono', 'Fira Code', monospace;
  letter-spacing: -0.01em;
}

.hmc-foot--green {
  color: #3fb950;
}

/* ---------- How It Works section (comprehensive) ---------- */
.hiw-section {
  padding: 120px 20px 100px;
  background:
    radial-gradient(900px 500px at 50% 0%, rgba(88, 166, 255, 0.06), transparent 55%),
    rgba(13, 17, 23, 0.9);
  border-top: 1px solid var(--line);
}

.hiw-container {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}

.hiw-title {
  font-size: clamp(1.8rem, 2.6vw, 2.6rem);
  font-weight: 900;
  color: #e6edf3;
  letter-spacing: -0.04em;
  margin: 16px 0 12px;
}

.hiw-subtitle {
  font-size: 17px;
  line-height: 1.7;
  color: rgba(230, 237, 243, 0.7);
  max-width: 640px;
  margin: 0 auto 48px;
}

/* 3-step cards */
.hiw-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 72px;
}

.hiw-card {
  background: rgba(22, 27, 34, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  padding: 2rem 1.6rem;
  text-align: left;
  backdrop-filter: blur(8px);
  transition: border-color 0.2s;
}

.hiw-card:hover {
  border-color: rgba(88, 166, 255, 0.22);
}

.hiw-step-num {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: rgba(88, 166, 255, 0.12);
  border: 1px solid rgba(88, 166, 255, 0.2);
  color: #58a6ff;
  font-size: 0.85rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.8rem;
}

.hiw-card h3 {
  font-size: 1.15rem;
  font-weight: 800;
  color: #e6edf3;
  margin: 0 0 0.6rem;
  letter-spacing: -0.02em;
}

.hiw-card p {
  font-size: 0.92rem;
  line-height: 1.65;
  color: rgba(230, 237, 243, 0.7);
  margin: 0;
}

/* ── Visual rows (image + text, alternating) ─── */
.hiw-visual-row {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 56px;
  align-items: center;
  text-align: left;
  padding: 80px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.hiw-visual-row--flip {
  grid-template-columns: 1fr 1.1fr;
}

.hiw-visual-row--flip .hiw-visual-media {
  order: -1;
}

.hiw-row-badge {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 6px;
  background: rgba(88, 166, 255, 0.12);
  color: #58a6ff;
  border: 1px solid rgba(88, 166, 255, 0.2);
  margin-bottom: 12px;
}

.hiw-visual-text h3 {
  font-size: 1.5rem;
  font-weight: 900;
  color: #e6edf3;
  margin: 0 0 16px;
  letter-spacing: -0.03em;
}

.hiw-visual-text p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(230, 237, 243, 0.75);
  margin: 0 0 16px;
}

.hiw-note {
  font-size: 0.88rem;
  color: rgba(230, 237, 243, 0.6);
  margin-top: 8px;
}

.hiw-visual-media img,
.hiw-visual-media video {
  width: 100%;
  height: auto;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.35);
}

.hiw-visual-media--video {
  aspect-ratio: 3/4;
  overflow: hidden;
  border-radius: 14px;
}

.hiw-visual-media--video video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 14px;
}

/* survival table inside HIW */
.hiw-table {
  margin: 16px 0;
}

/* ── Categories block ─── */
.hiw-categories-block {
  padding: 80px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  text-align: center;
}

.hiw-cat-title {
  font-size: clamp(1.4rem, 2.2vw, 2rem);
  font-weight: 900;
  color: #e6edf3;
  letter-spacing: -0.03em;
  margin: 16px 0 10px;
}

.hiw-cat-sub {
  font-size: 1rem;
  line-height: 1.7;
  color: rgba(230, 237, 243, 0.65);
  max-width: 640px;
  margin: 0 auto 36px;
}

.hiw-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.hiw-cat-card {
  background: rgba(22, 27, 34, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 16px;
  padding: 1.6rem 1.2rem;
  text-align: center;
  transition: border-color 0.2s, transform 0.2s;
}

.hiw-cat-card:hover {
  border-color: rgba(0, 242, 234, 0.22);
  transform: translateY(-2px);
}

.hiw-cat-icon {
  font-size: 1.5rem;
  margin-bottom: 0.7rem;
}

/* SVG icon variant for categories */
.hiw-cat-icon-svg {
  width: 32px;
  height: 32px;
  margin: 0 auto 0.7rem;
  color: #58a6ff;
  opacity: 0.8;
}

.hiw-cat-icon-svg svg {
  width: 100%;
  height: 100%;
}

.hiw-cat-card h4 {
  font-size: 0.95rem;
  font-weight: 800;
  color: #e6edf3;
  margin: 0 0 0.35rem;
  letter-spacing: -0.01em;
}

.hiw-cat-card p {
  font-size: 0.8rem;
  line-height: 1.5;
  color: rgba(230, 237, 243, 0.55);
  margin: 0;
}

/* interpretation pills */
.hiw-interp-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.hiw-pill {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #8b949e;
}

/* exchange callout */
.hiw-exchange-callout {
  background: rgba(35, 134, 54, 0.08);
  border: 1px solid rgba(35, 134, 54, 0.2);
  border-radius: 12px;
  padding: 16px 20px;
  margin: 16px 0;
  font-size: 0.9rem;
  line-height: 1.6;
  color: rgba(230, 237, 243, 0.85);
}

.hiw-doc-link {
  display: inline-block;
  color: #3fb950;
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 600;
  transition: opacity 0.15s;
}
.hiw-doc-link:hover {
  opacity: 0.8;
}

/* fan diagram */
.hiw-fan-row {
  padding: 48px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  text-align: center;
}

.hiw-fan-img {
  max-width: 700px;
  width: 100%;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
}

/* stats strip (inline in HIW) */
.hiw-stats {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 3rem;
  padding: 48px 0 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.hiw-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.hiw-stat-val {
  font-size: 2rem;
  font-weight: 900;
  color: #e6edf3;
  letter-spacing: -0.03em;
}

.hiw-stat-green {
  color: #3fb950;
}

.hiw-stat-label {
  font-size: 0.72rem;
  font-weight: 600;
  color: #8b949e;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.hiw-stat-sep {
  width: 1px;
  height: 36px;
  background: rgba(255, 255, 255, 0.08);
}

/* ---------- Responsive ---------- */
@media (max-width: 980px) {
  .landing-nav {
    padding: 1rem 1.25rem;
  }

  .content-container {
    grid-template-columns: 1fr;
  }

  .stats-grid .glass-card {
    grid-column: span 6;
  }

  .features-grid {
    grid-template-columns: 1fr;
  }

  .hiw-grid {
    grid-template-columns: 1fr;
    max-width: 480px;
    margin: 0 auto 72px;
  }

  .hiw-visual-row,
  .hiw-visual-row--flip {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .hiw-visual-row--flip .hiw-visual-media {
    order: 0;
  }

  .hiw-cat-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero-steps {
    flex-wrap: wrap;
  }

  .hiw-stats {
    flex-wrap: wrap;
    gap: 2rem 3rem;
  }

  .hiw-stat-sep {
    display: none;
  }
}

@media (max-width: 860px) {
  .hero-content {
    grid-template-columns: 1fr;
    gap: 36px;
    text-align: center;
  }
  .hero-left {
    text-align: center;
  }
  .hero-steps {
    justify-content: center;
  }
  .hero-cta {
    justify-content: center;
  }
  .hero-subtitle {
    margin: 0 auto 1.8rem auto;
    max-width: 560px;
  }
  .hero-market-card {
    max-width: 460px;
    margin: 0 auto;
  }
}

@media (max-width: 640px) {
  .landing-nav-links {
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-link {
    padding: 0.45rem 0.55rem;
  }

  .stats-section,
  .content-section,
  .features-section,
  .landing-footer {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .stats-grid .glass-card {
    grid-column: span 12;
  }

  .hiw-cat-grid {
    grid-template-columns: 1fr;
  }

  .hero-steps {
    flex-direction: column;
    align-items: center;
  }
}

/* ===============================================
   REAL-TIME CHART NEON GLOW (KEEP AS-IS)
   =============================================== */
.realtime-chart {
  position: relative;
}

/* Live indicator dot */
.realtime-chart .live-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  background: #00f2ea;
  border-radius: 50%;
  margin-right: 8px;
  animation: livePulse 2s ease-in-out infinite;
  box-shadow: 0 0 8px rgba(0, 242, 234, 0.7);
}

@keyframes livePulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.15);
  }
}

/* Neon glow on candlesticks */
.realtime-chart .apexcharts-series path[fill='#00f2ea'] {
  filter: drop-shadow(0 0 4px rgba(0, 242, 234, 0.6));
}

.realtime-chart .apexcharts-series path[fill='#ff0055'] {
  filter: drop-shadow(0 0 4px rgba(255, 0, 85, 0.6));
}

/* Make the grid lines extremely subtle */
.realtime-chart .apexcharts-gridline {
  stroke: rgba(255, 255, 255, 0.05);
}

/* Tooltip Glass Style */
.realtime-chart .apexcharts-tooltip {
  background: rgba(13, 17, 23, 0.9) !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  backdrop-filter: blur(5px);
  color: #fff;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5) !important;
}

.realtime-chart .apexcharts-tooltip-title {
  background: rgba(255, 255, 255, 0.1) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
  font-family: 'Inter', sans-serif !important;
}

.realtime-chart .apexcharts-text {
  fill: #8b949e !important; /* Axis label colors */
}

/* ---------- OAuth Button (Login Page) ---------- */
.oauthBtn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px 16px;
  border-radius: 12px;
  text-decoration: none;
  color: #fff;
  background: rgba(22, 27, 34, 0.60);
  border: 1px solid rgba(88, 166, 255, 0.18);
  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
  box-sizing: border-box;
}

.oauthBtn:hover {
  transform: translateY(-1px);
  border-color: rgba(88, 166, 255, 0.45);
  background: linear-gradient(135deg, rgba(88, 166, 255, 0.16), rgba(88, 166, 255, 0.05));
  box-shadow: 0 10px 30px rgba(88, 166, 255, 0.12);
}

.oauthBtn__inner {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  /* optical centering: the icon visually "pulls" left */
  transform: translateX(4px);
}

.oauthBtn__icon {
  width: 20px;
  height: 20px;
  display: grid;
  place-items: center;
  flex: 0 0 20px;
}

.oauthBtn__label {
  font-weight: 600;
  font-size: 16px;
  line-height: 1;
  opacity: 0.95;
}

/* Auth Form Stack */
.auth-stack {
  display: grid;
  gap: 16px;
}

/* ---------- Hero bridge line ---------- */
.hero-bridge-line {
  margin-top: 16px;
  font-size: 0.88rem;
  line-height: 1.6;
  color: rgba(230, 237, 243, 0.55);
  text-align: center;
  max-width: 420px;
  font-style: italic;
  letter-spacing: -0.01em;
}

/* ---------- Hero maturity strip (attached to card) ---------- */
/* ═══════════════ Maturity Strip (inside card) ═══════════════ */
.hero-maturity-strip {
  margin: 0 calc(-1 * var(--card-pad-x)) calc(-1 * var(--card-pad-y));
  padding: 14px var(--card-pad-x) 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.04);
  background: rgba(255, 255, 255, 0.015);
  border-radius: 0 0 calc(var(--card-radius) - 1px) calc(var(--card-radius) - 1px);
}

.hms-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 5px;
}

.hms-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  padding: 10px 4px 8px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.015);
  border: 1px solid rgba(255, 255, 255, 0.035);
  transition:
    border-color 0.25s,
    background 0.25s,
    transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
    box-shadow 0.3s;
  cursor: default;
}

.hms-cell:hover {
  border-color: rgba(88, 166, 255, 0.18);
  background: rgba(88, 166, 255, 0.035);
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
}

.hms-cell--active {
  border-color: rgba(88, 166, 255, 0.25);
  background: rgba(88, 166, 255, 0.06);
  box-shadow:
    0 0 12px rgba(88, 166, 255, 0.08),
    inset 0 0 10px rgba(88, 166, 255, 0.02);
}

.hms-date {
  font-size: 0.56rem;
  font-weight: 600;
  color: #6e7681;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

/* ── Mini bar chart inside cell ── */
.hms-bar-track {
  width: 18px;
  height: 28px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.03);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.hms-bar-fill {
  width: 100%;
  border-radius: 2px 2px 0 0;
  transition: height 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  min-height: 2px;
}

.hms-bar-fill.hms--green {
  background: linear-gradient(to top, rgba(63, 185, 80, 0.5), rgba(63, 185, 80, 0.2));
}

.hms-bar-fill.hms--dim {
  background: linear-gradient(to top, rgba(139, 148, 158, 0.3), rgba(139, 148, 158, 0.1));
}

.hms-val {
  font-size: 0.78rem;
  font-weight: 800;
  font-family: 'SF Mono', 'Fira Code', monospace;
  letter-spacing: -0.03em;
}

.hms-val.hms--green { color: #3fb950; }
.hms-val.hms--dim { color: #8b949e; }

/* ---------- Credibility cues row ---------- */
.hero-cred {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 0.6rem;
  animation: zoomIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
  opacity: 0;
}

.hero-cred-item {
  font-size: 0.7rem;
  font-weight: 600;
  color: rgba(139, 148, 158, 0.7);
  letter-spacing: 0.01em;
}

.hero-cred-sep {
  margin: 0 0.55rem;
  color: rgba(110, 118, 129, 0.35);
  font-size: 0.5rem;
  user-select: none;
}

/* ---------- HIW plain list (contract structure) ---------- */
.hiw-plain-list {
  list-style: none;
  padding: 0;
  margin: 8px 0 16px;
}

.hiw-plain-list li {
  position: relative;
  padding-left: 20px;
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(230, 237, 243, 0.75);
  margin-bottom: 4px;
}

.hiw-plain-list li::before {
  content: "→";
  position: absolute;
  left: 0;
  color: #58a6ff;
  font-weight: 700;
}

/* ---------- HIW product list (index layer, daily-settled) ---------- */
.hiw-product-list {
  list-style: none;
  padding: 0;
  margin: 12px 0 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.hiw-product-list li {
  position: relative;
  padding-left: 22px;
  font-size: 0.92rem;
  line-height: 1.6;
  color: rgba(230, 237, 243, 0.8);
}

.hiw-product-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 9px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(88, 166, 255, 0.35);
  border: 1px solid rgba(88, 166, 255, 0.5);
}

/* ---------- Exchange fee badge ---------- */
.hiw-exchange-fee-badge {
  display: inline-block;
  margin: 12px 0;
  padding: 6px 16px;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: #3fb950;
  background: rgba(63, 185, 80, 0.1);
  border: 1px solid rgba(63, 185, 80, 0.22);
}

/* ---------- "What this achieves" block ---------- */
.hiw-achieves-block {
  padding: 80px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  text-align: center;
}

.hiw-achieves-lead {
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(230, 237, 243, 0.7);
  max-width: 640px;
  margin: 0 auto 28px;
}

.hiw-achieves-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
  max-width: 700px;
  margin: 0 auto 24px;
}

.hiw-achieves-item {
  padding: 14px 20px;
  border-radius: 12px;
  background: rgba(22, 27, 34, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.07);
  font-size: 0.92rem;
  line-height: 1.5;
  color: rgba(230, 237, 243, 0.8);
  text-align: left;
}

.hiw-achieves-footer {
  font-size: 0.95rem;
  line-height: 1.7;
  color: rgba(230, 237, 243, 0.6);
  max-width: 640px;
  margin: 0 auto;
}

/* ---------- 5-column category grid ---------- */
.hiw-cat-grid--5 {
  grid-template-columns: repeat(5, 1fr);
}

@media (max-width: 980px) {
  .hiw-cat-grid--5 {
    grid-template-columns: repeat(3, 1fr);
  }
  .hiw-achieves-list {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .hiw-cat-grid--5 {
    grid-template-columns: 1fr;
  }
}

/* ---------- Index transformation stack ---------- */
.hiw-index-stack {
  margin: 20px 0 8px;
  display: flex;
  flex-direction: column;
  gap: 0;
  max-width: 280px;
}

.hiw-index-level {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border-radius: 8px;
  background: rgba(22, 27, 34, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 0.88rem;
  font-weight: 600;
  color: rgba(230, 237, 243, 0.8);
}

.hiw-index-level--end {
  background: rgba(88, 166, 255, 0.08);
  border-color: rgba(88, 166, 255, 0.2);
  color: #58a6ff;
  font-weight: 800;
}

.hiw-idx-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(230, 237, 243, 0.25);
  flex-shrink: 0;
}

.hiw-idx-dot--mid {
  background: rgba(143, 174, 213, 0.5);
}

.hiw-idx-dot--end {
  background: #58a6ff;
  box-shadow: 0 0 8px rgba(88, 166, 255, 0.4);
}

.hiw-index-arrow {
  text-align: center;
  font-size: 0.7rem;
  color: rgba(230, 237, 243, 0.25);
  padding: 2px 0;
  line-height: 1;
}

/* ---------- Settlement timeline ---------- */
.hiw-settlement-timeline {
  display: flex;
  align-items: flex-end;
  gap: 0;
  margin: 20px 0 8px;
  position: relative;
  padding-bottom: 2px;
}

.hiw-settlement-timeline::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(255, 255, 255, 0.06);
}

.hst-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding-bottom: 10px;
  position: relative;
}

.hst-marker {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(143, 174, 213, 0.4);
  border: 1px solid rgba(143, 174, 213, 0.6);
}

.hst-marker--final {
  background: #3fb950;
  border-color: rgba(63, 185, 80, 0.6);
  box-shadow: 0 0 8px rgba(63, 185, 80, 0.3);
}

.hst-label {
  font-size: 0.62rem;
  font-weight: 600;
  color: #6e7681;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.hst-val {
  font-size: 0.78rem;
  font-weight: 700;
  color: #3fb950;
  font-family: 'SF Mono', 'Fira Code', monospace;
}

.hst-neg {
  color: #f0615d;
}

.hst-final {
  color: #e6edf3;
  font-weight: 800;
}

.hst-day--settle .hst-label {
  color: #3fb950;
}
