            </div>
          </div>

          {/* ── Contract definition with image ──────────────── */}
          <div className="hiw-visual-row">
            <div className="hiw-visual-text">
              <span className="hiw-row-badge">Contract Structure</span>
              <h3>Binary payoffs</h3>
              <p>
                Let <InlineMath math="\tau" /> denote the random time at which a defined event occurs.
                For any maturity <InlineMath math="T" />, the contract defines two complementary binary payoffs:
              </p>
              <div className="smm-math-block">
                <BlockMath math="Y(T) = \mathbf{1}_{\{\tau > T\}}" />
                <BlockMath math="N(T) = \mathbf{1}_{\{\tau \leq T\}}" />
